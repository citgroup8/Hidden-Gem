// Hidden Gem database schema (PostgreSQL).
// Rebuilt from how the backend code uses Prisma. Create the tables with:
//   npm run db:push        (from the backend folder or the repository root)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- users

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  clerkUserId            String?   @unique
  googleId               String?   @unique
  passwordHash           String?
  username               String
  usernameNormalized     String    @unique
  displayName            String?
  bio                    String?
  profileImageUrl        String?
  profileComplete        Boolean   @default(false)
  emailVerifiedAt        DateTime?

  // presence
  isOnline               Boolean   @default(false)
  lastSeenAt             DateTime?

  // location sharing (private by default)
  defaultLocationPrivacy String    @default("off") // off | friends_only | public
  liveLocationMode       String    @default("off") // off | friends_only | public
  shareLocation          Boolean   @default(false)
  latitude               Float?
  longitude              Float?
  lastLocationAt         DateTime?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  friendshipsA           Friendship[]    @relation("FriendshipUserA")
  friendshipsB           Friendship[]    @relation("FriendshipUserB")
  sentMessages           Message[]       @relation("SentMessages")
  receivedMessages       Message[]       @relation("ReceivedMessages")
  gems                   Gem[]
  spots                  Spot[]
  spotShares             SpotShare[]
  savedGems              SavedGem[]
  savedSpots             SavedSpot[]
  comments               PostComment[]
  notifications          Notification[]
  blocksMade             UserBlock[]     @relation("Blocker")
  blocksReceived         UserBlock[]     @relation("Blocked")
  reportsMade            UserReport[]    @relation("Reporter")
  reportsReceived        UserReport[]    @relation("Reported")

  @@index([username])
  @@index([liveLocationMode, isOnline])
}

// ------------------------------------------------------- sign-in codes

model EmailOtp {
  id          String   @id @default(cuid())
  email       String   @unique
  codeHash    String
  purpose     String // signup | login
  username    String?
  displayName String?
  attempts    Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

// Used through raw SQL in lib/rate-limit.ts, so column names must stay exactly as they are.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
  expiresAt   DateTime

  @@index([expiresAt])
}

// -------------------------------------------------------------- friends

model FriendRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("pending") // pending | accepted | declined | canceled
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender       User          @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User          @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  notification Notification?

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  status    String   @default("accepted") // accepted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
}

model UserBlock {
  id            String   @id @default(cuid())
  blockerId     String
  blockedUserId String
  createdAt     DateTime @default(now())

  blocker     User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser User @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId])
}

model UserReport {
  id             String   @id @default(cuid())
  reporterId     String
  reportedUserId String
  reason         String
  details        String?
  createdAt      DateTime @default(now())

  reporter     User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reporterId, createdAt])
  @@index([reportedUserId])
}

// ------------------------------------------------------------- messages

model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  receiverId     String
  text           String
  deliveredAt    DateTime?
  readAt         DateTime?
  isDeleted      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, receiverId])
  @@index([receiverId, readAt])
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  friendRequestId String?  @unique
  type            String // friend_request | message | ...
  payloadJson     String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  friendRequest FriendRequest? @relation(fields: [friendRequestId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ---------------------------------------------- map content: Gems & Spots

// Gems are public and discoverable by everyone.
model Gem {
  id          String    @id @default(cuid())
  creatorId   String
  title       String
  description String?
  category    String
  latitude    Float
  longitude   Float
  isPublic    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator  User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  photos   GemPhoto[]
  comments PostComment[]
  savedBy  SavedGem[]

  @@index([latitude, longitude])
  @@index([creatorId])
}

// Spots are private: visible to the creator and the friends they share with.
model Spot {
  id          String   @id @default(cuid())
  creatorId   String
  title       String
  description String?
  category    String
  latitude    Float
  longitude   Float
  visibility  String   @default("private") // private | selected | friends
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator  User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  shares   SpotShare[]
  photos   SpotPhoto[]
  comments PostComment[]
  savedBy  SavedSpot[]

  @@index([latitude, longitude])
  @@index([creatorId])
}

model SpotShare {
  id        String   @id @default(cuid())
  spotId    String
  userId    String
  createdAt DateTime @default(now())

  spot Spot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spotId, userId])
  @@index([userId])
}

model GemPhoto {
  id        String   @id @default(cuid())
  gemId     String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  gem Gem @relation(fields: [gemId], references: [id], onDelete: Cascade)

  @@index([gemId, createdAt])
}

model SpotPhoto {
  id        String   @id @default(cuid())
  spotId    String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  spot Spot @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@index([spotId, createdAt])
}

model SavedGem {
  userId    String
  gemId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gem  Gem  @relation(fields: [gemId], references: [id], onDelete: Cascade)

  @@id([userId, gemId])
  @@index([gemId])
}

model SavedSpot {
  userId    String
  spotId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  spot Spot @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@id([userId, spotId])
  @@index([spotId])
}

// A comment belongs to either a Gem or a Spot.
model PostComment {
  id        String   @id @default(cuid())
  gemId     String?
  spotId    String?
  authorId  String
  text      String
  createdAt DateTime @default(now())

  gem    Gem?  @relation(fields: [gemId], references: [id], onDelete: Cascade)
  spot   Spot? @relation(fields: [spotId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([gemId, createdAt])
  @@index([spotId, createdAt])
  @@index([authorId])
}
