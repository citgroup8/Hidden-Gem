# Copy to backend/.env and fill in. Never commit .env.

# --- Database & sessions
DATABASE_URL=postgresql://hidden_gem:hidden_gem@localhost:5432/hidden_gem
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Public URL people use in the browser: the FRONTEND address (used to build OAuth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OTP / email delivery ("twilio" or "resend")
OTP_DELIVERY_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TO_NUMBER=

# --- Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Clerk (must be the same Clerk application as the frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
